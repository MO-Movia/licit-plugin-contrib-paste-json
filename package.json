{
  "name": "@modusoperandi/licit-paste-json",
  "version": "1.0.0",
  "type": "module",
  "description": "MO's ProseMirror Plugin that allows you to paste in prosemirror JSON into the editor.",
  "main": "index.js",
  "typings": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/licit-plugin-contrib-paste-json"
  },
  "peerDependencies": {
    "prosemirror-model": "^1.16.1",
    "prosemirror-state": "^1.4.2",
    "prosemirror-transform": "^1.7.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.5.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-react": "^7.31.11",
    "file-loader": "^6.2.0",
    "husky": "^9.0.10",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^17.0.0",
    "jest-prosemirror": "^3.0.0",
    "lint-staged": "^17.0.5",
    "style-loader": "^4.0.0",
    "stylelint": "^17.0.0",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "libxmljs2": "^1.0.0"
  },
  "scripts": {
    "test": "jest --coverage",
    "clean": "rm -rf dist/ && rm -f modusoperandi-licit-paste-json-*.*.*.tgz",
    "lint:ts": "eslint src --ext .ts --fix",
    "lint": "npm run lint:ts",
    "ci:build": "tsc --build && copyfiles --up 1 \"src/**/*.css\" dist  && copyfiles package.json LICENSE dist",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "publish:dist": "npm publish",
    "ci:bom": "cyclonedx-npm --ignore-npm-errors --short-PURLs --output-format XML --output-file dist/bom.xml",
    "verify": "npm run lint -- --fix && npm run ci:build && npm run test:coverage && echo 'All Tests Passed!'"
  },
  "importSort": {
    ".js": {
      "parser": "babylon",
      "style": "module-grouping"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "!(*test|*.setup).ts": [
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}